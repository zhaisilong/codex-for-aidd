# 使用时请重命名为 .gitignore

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# 密钥与本地配置
.env
